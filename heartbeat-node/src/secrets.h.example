// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// Every heartbeat board runs the same image at every pond, so list every
// pond's network plus the bench. Tried in order at boot (after the board's own
// NVS target and its pond's RTDB entry, see shared/SiteWiFi).
#define WIFI_NETWORKS               \
  {                                 \
    {"bench-ssid", "password"},     \
    {"pond-a-ssid", "password"},    \
  }

// The hand-opened phone hotspot, tried last.
#define RESCUE_SSID "pond-rescue"
#define RESCUE_PASS "choose-a-password"

#define RTDB_HOST "<project>-default-rtdb.<region>.firebasedatabase.app"

// Gates /wifi and /rescue so a stray request on the LAN cannot reconfigure a
// board.
#define OTA_PASSWORD "choose-a-password"

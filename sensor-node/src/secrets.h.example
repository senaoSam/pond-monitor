// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// Networks are tried in order at boot, so the same firmware runs on the bench
// and at the pond with no reflash when the board is moved. Keep the bench
// network first: it is where OTA updates happen.
#define WIFI_NETWORKS               \
  {                                 \
    {"bench-ssid", "password"},     \
    {"pond-ssid", "password"},      \
  }

#define RTDB_HOST "<project>-default-rtdb.<region>.firebasedatabase.app"

// Guards wireless flashing so nothing else on the LAN can push firmware.
// Must match upload_flags --auth= in platformio.ini.
#define OTA_PASSWORD "choose-a-password"

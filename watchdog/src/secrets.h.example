// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// Networks are tried in order at boot, so moving the board needs no reflash.
#define WIFI_NETWORKS               \
  {                                 \
    {"bench-ssid", "password"},     \
    {"home-ssid", "password"},      \
    {"pond-ssid", "password"},      \
  }

#define RTDB_HOST "<project>-default-rtdb.<region>.firebasedatabase.app"

// Guards wireless flashing so nothing else on the LAN can push firmware.
// Must match upload_flags --auth= in platformio.ini.
#define OTA_PASSWORD "choose-a-password"

// Discord. The bot token is stored in flash, so anyone with physical access
// to the board can read it -- reset it in the Developer Portal if the board
// is ever lost.
#define DISCORD_BOT_TOKEN "<bot token from Developer Portal>"
#define DISCORD_CHANNEL_ID "<right-click channel > Copy Channel ID>"

// Numeric user id (Settings > Advanced > Developer Mode, then right-click your
// avatar > Copy User ID). A mention is what makes the phone push the alert, so
// a username here would silently degrade to plain text.
#define DISCORD_USER_ID "<your numeric user id>"
